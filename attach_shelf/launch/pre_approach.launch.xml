<launch>

  <!-- Declare launch arguments -->
  <arg name="obstacle" default="0.2"/>
  <arg name="degrees" default="1"/>
  <arg name="rviz_config_file_name" default="checkpoint5.rviz"/>

 <!-- RViz -->
  <node
    pkg="rviz2"
    exec="rviz2"
    name="rviz2"
    output="screen"
    args="-d $(find-pkg-share attach_shelf)/rviz/$(var rviz_config_file_name)">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Node definition -->
  <node
    pkg="attach_shelf"
    exec="pre_approach"
    name="PreApproachNode"
    output="screen"
    emulate_tty="true">

    <!-- Parameters -->
    <param name="obstacle" value="$(var obstacle)"/>
    <param name="degrees" value="$(var degrees)"/>

  </node>

   
</launch>